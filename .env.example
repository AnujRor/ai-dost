# OPENROUTER_API_KEY: main AI provider (free models). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL (optional): model to try first. Defaults: openrouter/free -> google/gemma-4-31b-it:free -> qwen/qwen3.8-27b:free
# OPENROUTER_MODEL="openrouter/free"

# GEMINI_API_KEY (optional backup): used if OpenRouter fails. Get one at https://aistudio.google.com/apikey
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL (optional): model to try first. Defaults: gemini-3.8-flash -> gemini-3.5-flash -> gemini-flash-latest -> gemini-3.1-flash-lite
# GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted (also sent to OpenRouter as the app referer).
APP_URL="MY_APP_URL"

# PORT (optional): server port, default 3000
# PORT=3001
